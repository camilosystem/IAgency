{
  "$comentario": [
    "Configuración base de un proyecto de la fábrica IAgency.",
    "defaultMode 'dontAsk': el agente NUNCA pregunta. Todo lo que esté en allow corre",
    "solo; todo lo demás se deniega en silencio. Es la forma correcta de tener cero",
    "confirmaciones SIN perder los guardarraíles, a diferencia de bypassPermissions,",
    "que desactiva también las reglas deny.",
    "Si un agente se queda corto, se AMPLÍA la lista allow — no se cambia el modo."
  ],

  "permissions": {
    "defaultMode": "dontAsk",

    "allow": [
      "Read(//workspace/**)",
      "Edit(//workspace/**)",
      "Write(//workspace/**)",
      "Glob(**)",
      "Grep(**)",
      "TodoWrite",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin agente/*)",

      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet run *)",
      "Bash(dotnet format *)",
      "Bash(dotnet ef migrations *)",

      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",

      "Bash(python3 *)",
      "Bash(pip install *)",
      "Bash(pytest *)",
      "Bash(ruff *)",

      "Bash(ls *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)",
      "Bash(rg *)", "Bash(find *)", "Bash(wc *)", "Bash(sort *)", "Bash(uniq *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(touch *)",
      "Bash(sed *)", "Bash(awk *)", "Bash(jq *)", "Bash(diff *)",
      "Bash(echo *)", "Bash(printf *)", "Bash(which *)", "Bash(env)",
      "Bash(sha256sum *)", "Bash(tar *)", "Bash(zip *)", "Bash(unzip *)",
      "Bash(curl -s http://localhost:*)",
      "Bash(sqlcmd -S localhost *)",
      "Bash(psql -h localhost *)",
      "Bash(docker compose *)",

      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:*.npmjs.com)",
      "WebFetch(domain:nuget.org)",
      "WebFetch(domain:stackoverflow.com)",
      "WebSearch"
    ],

    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(mkfs*)",
      "Bash(dd *)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git reset --hard origin*)",
      "Bash(git filter-branch*)",
      "Bash(git config --global*)",
      "Bash(crontab *)",
      "Bash(systemctl *)",
      "Bash(iptables *)",
      "Bash(nft *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(claude *)",

      "Read(**/.env)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",

      "Edit(**/.env)",
      "Edit(**/.claude/**)",
      "Edit(**/.mcp.json)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Edit(**/.devcontainer/**)",
      "Edit(**/.github/workflows/**)",
      "Write(**/.env)",
      "Write(**/.claude/**)",
      "Write(**/.git/hooks/**)"
    ],

    "additionalDirectories": [],
    "blockReadsOutsideWorkingDirectories": true
  },

  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowRead": ["."],
      "allowWrite": [".", "/tmp"],
      "denyRead": ["~/.ssh", "~/.aws", "~/.config/gcloud"],
      "denyWrite": [".env", ".git/hooks", ".claude", ".mcp.json"]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "api.nuget.org",
        "*.nuget.org",
        "pypi.org",
        "files.pythonhosted.org",
        "docs.claude.com",
        "code.claude.com",
        "learn.microsoft.com",
        "developer.mozilla.org"
      ]
    },
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true
  },

  "env": {
    "IAGENCY_ENTORNO": "pruebas",
    "IAGENCY_MAX_HERRAMIENTAS": "400",
    "IAGENCY_AUDIT_LOG": "/var/log/iagency/comandos.log",
    "IAGENCY_ESTADO": "/var/lib/iagency"
  },

  "extraKnownMarketplaces": {
    "iagency": {
      "source": {
        "source": "github",
        "repo": "camilosystem/IAgency"
      }
    }
  },
  "enabledPlugins": {
    "iagency-core@iagency": true
  }
}
