# Este repositorio se consume en Linux: el nodo de la fábrica, los contenedores de
# los agentes y el orquestador. Un script .sh con finales de línea CRLF NO se ejecuta
# en Linux — falla con "bad interpreter" o "$'\r': command not found", y el error no
# dice nada útil sobre la causa real.
#
# Por eso todo se normaliza a LF, aunque se edite desde Windows.

* text=auto eol=lf

*.sh          text eol=lf
*.py          text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.conf        text eol=lf
Dockerfile*   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Los scripts de PowerShell sí van con CRLF: corren en Windows.
*.ps1         text eol=crlf

# Binarios: que git no los toque.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.gz   binary
*.zip  binary
*.tar  binary
